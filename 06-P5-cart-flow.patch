--- P4/src/components/product/add-to-cart-button.tsx	1970-01-01 00:00:00.000000000 +0000
+++ P5/src/components/product/add-to-cart-button.tsx	2026-08-08 07:49:03.192918854 +0000
@@ -0,0 +1,27 @@
+'use client';
+
+import { useTranslations } from 'next-intl';
+import { useCartStore } from '@/stores/cart-store';
+
+interface AddToCartButtonProps {
+  productId: string;
+}
+
+export function AddToCartButton({ productId }: AddToCartButtonProps) {
+  const t = useTranslations('product');
+  const addItem = useCartStore((state) => state.addItem);
+  const openCart = useCartStore((state) => state.openCart);
+
+  return (
+    <button
+      type="button"
+      onClick={() => {
+        addItem(productId);
+        openCart();
+      }}
+      className="inline-block bg-foreground text-background px-8 py-4 text-sm tracking-widest uppercase hover:bg-foreground/90 transition-colors"
+    >
+      {t('addToCart')}
+    </button>
+  );
+}
