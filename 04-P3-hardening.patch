diff -ruN '--exclude=prototype' '--exclude=images' P2/src/hooks/use-is-client.ts P3/src/hooks/use-is-client.ts
--- P2/src/hooks/use-is-client.ts	1970-01-01 00:00:00.000000000 +0000
+++ P3/src/hooks/use-is-client.ts	2026-08-08 07:47:23.556695130 +0000
@@ -0,0 +1,18 @@
+'use client';
+import { useSyncExternalStore } from 'react';
+
+const subscribe = () => () => {};
+
+/**
+ * Returns true only after the component has mounted on the client.
+ * Use this instead of `useEffect(() => setState(true), [])` for SSR/CSR
+ * mismatch cases (e.g. portals that need `document`) — this avoids
+ * calling setState synchronously inside an effect.
+ */
+export function useIsClient(): boolean {
+  return useSyncExternalStore(
+    subscribe,
+    () => true,
+    () => false
+  );
+}
